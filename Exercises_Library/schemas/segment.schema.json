{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightreader:v2:segment",
  "title": "Sightreader v2 — segment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "segment_id",
    "piece_id",
    "asset_id",
    "input_sha256",
    "status",
    "measure_addressing",
    "start_measure_index",
    "end_measure_index_exclusive",
    "source_measure_labels",
    "part_selection",
    "start_context",
    "boundary_review_status",
    "analysis",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "segment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "piece_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "asset_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "planned",
        "extracted",
        "ready",
        "rejected"
      ]
    },
    "measure_addressing": {
      "enum": [
        "zero_based_written_order"
      ]
    },
    "start_measure_index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "end_measure_index_exclusive": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_measure_labels": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "part_selection": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "part_id",
              "staves",
              "role"
            ],
            "properties": {
              "part_id": {
                "type": "string",
                "minLength": 1
              },
              "staves": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "role": {
                "enum": [
                  "piano",
                  "right_hand",
                  "left_hand",
                  "other"
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "start_context": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key_signatures",
            "time_signatures",
            "clefs",
            "divisions",
            "transpositions",
            "tempo_bpm",
            "pickup_quarter_notes",
            "cross_boundary_ties",
            "repeat_context"
          ],
          "properties": {
            "key_signatures": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "part_id",
                      "staff",
                      "measure_index",
                      "fifths",
                      "mode",
                      "nontraditional"
                    ],
                    "properties": {
                      "part_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "staff": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "measure_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "fifths": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "mode": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "nontraditional": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "time_signatures": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "part_id",
                      "staff",
                      "measure_index",
                      "beats",
                      "beat_type"
                    ],
                    "properties": {
                      "part_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "staff": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "measure_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "beats": {
                        "type": "string",
                        "minLength": 1
                      },
                      "beat_type": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "clefs": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "part_id",
                      "staff",
                      "sign",
                      "line",
                      "octave_change"
                    ],
                    "properties": {
                      "part_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "staff": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "sign": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "octave_change": {
                        "type": "integer"
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "divisions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "transpositions": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "part_id",
                      "chromatic",
                      "diatonic",
                      "octave_change"
                    ],
                    "properties": {
                      "part_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "chromatic": {
                        "type": "number"
                      },
                      "diatonic": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "octave_change": {
                        "type": "integer"
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "tempo_bpm": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "pickup_quarter_notes": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "cross_boundary_ties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "repeat_context": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "boundary_review_status": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "analysis": {
      "$ref": "urn:sightreader:v2:analysis"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "fields",
          "source_record"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_record": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "extracted",
              "ready"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_measure_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_measure_index_exclusive": {
            "type": "integer",
            "minimum": 1
          },
          "source_measure_labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "part_selection": {
            "type": "array",
            "minItems": 1
          },
          "start_context": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "boundary_review_status": {
            "const": "approved"
          },
          "analysis": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          }
        }
      }
    }
  ]
}
