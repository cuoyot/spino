{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sightreader:v2:sources",
  "title": "Sightreader v2 — sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "name",
          "homepage",
          "enabled",
          "role",
          "preferred_formats",
          "repository",
          "revision",
          "download_strategy",
          "license_policy",
          "evidence_ids",
          "notes"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "homepage": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "enabled": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "preferred_formats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "repository": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "download_strategy": {
            "type": "string",
            "minLength": 1
          },
          "license_policy": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
