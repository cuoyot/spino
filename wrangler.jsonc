// Static website, byte-range video playback and signed downloads above 25 MiB.
// Regenerate site/ with `node scripts/site/build-site.mjs`; see docs/play-store/README.md.
{
  "name": "spino",
  "main": "scripts/site/download-worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/downloads/*.apk", "/media/*.mp4"],
    "not_found_handling": "404-page"
  }
}
